# Copy to .env or export these variables in the service environment.
# Generate each value with: python3 -c "import secrets; print(secrets.token_hex(32))"
MNCWUI_API_KEY=replace_with_a_unique_secret
TACGNS_API_KEY=replace_with_a_different_unique_secret
AFKO_START_AETHORFORGE=false
AFKO_PUBLISH_AETHORFORGE=false
AETHORFORGE_HOST=127.0.0.1
AETHORFORGE_PORT=8080
AETHORFORGE_URL=http://127.0.0.1:8080